  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "H\u1EC7 th\u1ED1ng \u0111\u01B0\u1EE3c x\xE2y d\u1EF1ng theo c\u1EA5u
    tr\xFAc \u0111i\u1EC1u khi\u1EC3n v\xF2ng k\xEDn. Ng\u01B0\u1EDDi v\u1EADn h\xE0nh
    nh\u1EADp l\u1EC7nh tr\xEAn HMI, PLC x\u1EED l\xFD l\u1EC7nh v\xE0 ph\xE1t xung
    t\u1ED1c \u0111\u1ED9 cao \u0111\u1EBFn Servo Driver. Driver khu\u1EBFch \u0111\u1EA1i
    v\xE0 bi\u1EBFn \u0111\u1ED5i t\xEDn hi\u1EC7u \u0111i\u1EC1u khi\u1EC3n th\xE0nh
    \u0111i\u1EC7n \xE1p ba pha c\u1EA5p cho \u0111\u1ED9ng c\u01A1 BLDC Servo. Encoder
    g\u1EAFn v\u1EDBi tr\u1EE5c \u0111\u1ED9ng c\u01A1 t\u1EA1o xung ph\u1EA3n h\u1ED3i
    v\u1EC1 PLC, nh\u1EDD \u0111\xF3 h\u1EC7 th\u1ED1ng x\xE1c \u0111\u1ECBnh \u0111\u01B0\u1EE3c
    chi\u1EC1u quay, t\u1ED1c \u0111\u1ED9 v\xE0 v\u1ECB tr\xED th\u1EF1c t\u1EBF
    \u0111\u1EC3 gi\u1EA3m sai l\u1EC7ch so v\u1EDBi gi\xE1 tr\u1ECB \u0111\u1EB7t.\r\n\u2022
    T\u1ED1c \u0111\u1ED9 \u0111\u1ED9ng c\u01A1 ph\u1EE5 thu\u1ED9c v\xE0o t\u1EA7n
    s\u1ED1 xung ph\xE1t t\u1EEB PLC.\r\n\u2022 V\u1ECB tr\xED/g\xF3c quay ph\u1EE5
    thu\u1ED9c v\xE0o t\u1ED5ng s\u1ED1 xung \u0111i\u1EC1u khi\u1EC3n \u0111\u01B0\u1EE3c
    ph\xE1t ra.\r\n\u2022 Encoder pha A/B l\u1EC7ch nhau 90\xB0 gi\xFAp x\xE1c \u0111\u1ECBnh
    chi\u1EC1u quay v\xE0 s\u1ED1 xung th\u1EF1c t\u1EBF.\r\n\u2022 Bi\xEAn d\u1EA1ng
    t\u0103ng t\u1ED1c \u2013 ch\u1EA1y \u0111\u1EC1u \u2013 gi\u1EA3m t\u1ED1c gi\xFAp
    \u0111\u1ED9ng c\u01A1 v\u1EADn h\xE0nh \xEAm, h\u1EA1n ch\u1EBF qu\xE1 t\u1EA3i
    ho\u1EB7c tr\u01B0\u1EE3t c\u01A1 kh\xED.\r\n"
  m_isRightToLeft: 0
